{
  "name": "controlled-copy-trading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cct/web",
    "dev:web": "npm run dev --workspace @cct/web",
    "build": "npm run build --workspace @cct/web",
    "build:web": "npm run build --workspace @cct/web",
    "typecheck:web": "npm run typecheck --workspace @cct/web",
    "check": "node scripts/check-project.mjs && node scripts/check-storage.mjs",
    "test:repository": "node --test scripts/check-storage.test.mjs && python3 scripts/test_branch_cleanup.py",
    "dev:admin": "npm run dev --workspace @cct/admin",
    "build:admin": "npm run build --workspace @cct/admin",
    "typecheck:admin": "npm run typecheck --workspace @cct/admin",
    "build:all": "npm run build:web && npm run build:admin"
  }
}
