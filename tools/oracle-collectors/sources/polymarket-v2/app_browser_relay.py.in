"""Read-only SSH stdio bridge to the active protected /app for IAB acceptance."""
import base64
from http.server import BaseHTTPRequestHandler, HTTPServer
import json
from pathlib import Path
import re
import subprocess
import sys
from urllib.error import HTTPError
from urllib.parse import urlsplit
from urllib.request import HTTPRedirectHandler, ProxyHandler, Request, build_opener

ORIGIN = '@@ORACLE_APP_ORIGIN@@'
HANDOFF = Path('/opt/shadow-polygon/.browser-e2e.e99162d8/participant-handoff/participant-a.json')
ROUTES = frozenset({'/app/', '/app/home', '/app/positions', '/app/activity', '/app/demo-feed.json'})
ASSET = re.compile(r'/app/assets/[A-Za-z0-9_-]+\.(?:css|js)')
LIMIT = 1_500_000


def allowed(url):
    target = urlsplit(url)
    if target.scheme or target.netloc or target.query or target.fragment:
        return False
    return target.path in ROUTES or ASSET.fullmatch(target.path) is not None


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def upstream():
    profile = json.loads(HANDOFF.read_text())
    auth = 'Basic '+base64.b64encode((profile['username']+':'+profile['password']).encode()).decode()
    opener = build_opener(ProxyHandler({}), NoRedirect())
    for line in sys.stdin:
        route = json.loads(line)
        if not allowed(route):
            print(json.dumps({'status':404}),flush=True)
            continue
        try:
            with opener.open(Request(ORIGIN+route,headers={'Authorization':auth}),timeout=5) as response:
                data = response.read(LIMIT+1)
                if len(data)>LIMIT:
                    raise ValueError('response too large')
                reply = {'status':response.status,'type':response.headers.get('Content-Type','text/plain'),
                         'data':base64.b64encode(data).decode()}
        except HTTPError as error:
            reply = {'status':error.code}
        except (OSError,ValueError):
            reply = {'status':502}
        print(json.dumps(reply,separators=(',',':')),flush=True)


def local(arguments, remote):
    process = subprocess.Popen(['ssh',*arguments, remote],stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True)

    class Handler(BaseHTTPRequestHandler):
        def log_message(self,*args):
            pass

        def do_GET(self):
            if not allowed(self.path):
                self.send_error(404)
                return
            try:
                process.stdin.write(json.dumps(self.path)+'\n')
                process.stdin.flush()
                result=json.loads(process.stdout.readline(2*LIMIT))
                data=base64.b64decode(result.get('data',''),validate=True)
            except (OSError,ValueError):
                self.send_error(502)
                return
            self.send_response(result['status'])
            self.send_header('Content-Type',result.get('type','text/plain'))
            self.send_header('Content-Length',str(len(data)))
            self.send_header('Cache-Control','no-store')
            self.end_headers()
            self.wfile.write(data)

    try:
        with HTTPServer(('127.0.0.1',0),Handler) as server:
            print(json.dumps({'port':server.server_port}),flush=True)
            server.serve_forever(poll_interval=.2)
    finally:
        process.stdin.close()
        process.terminate()
        process.wait(timeout=5)


if __name__=='__main__':
    if sys.argv[1:]==['upstream']:
        upstream()
    else:
        local(json.loads(sys.argv[1]),sys.argv[2])
