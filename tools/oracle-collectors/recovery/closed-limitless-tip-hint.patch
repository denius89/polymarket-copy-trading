diff --git a/limitless_tip_hint.py b/limitless_tip_hint.py
new file mode 100644
index 0000000..80621da
--- /dev/null
+++ b/limitless_tip_hint.py
@@ -0,0 +1,93 @@
+"""Unfinalized Base notifications can warm a book, never authorize a purchase."""
+from collections import OrderedDict, Counter
+import json
+from queue import Empty, Full
+import select
+import socket
+import ssl
+import time
+
+from book_engine import GateSkip
+import source
+from trader_address_probe import resolve_limitless
+from trader_limitless import collect, market_from_detail
+
+HOST = 'base-rpc.publicnode.com'
+TTL_MS = 30_000
+
+
+def hint_for(log, wallet, observed, allow_no):
+    if (log.get('removed') is not False or len(log.get('topics', ())) != 4
+            or log['topics'][2] != source.address_topic(wallet)):
+        return None
+    item = next(collect([log], {wallet}, observed, {}, Counter()), None)
+    if item is None:
+        return None
+    _, _, token, _ = item
+    mapped, _ = resolve_limitless(log, wallet, token, 'BUY', None)
+    if mapped is None:
+        return None
+    detail, outcome = mapped
+    expiration = detail.get('expirationTimestamp')
+    if type(expiration) is not int:
+        return None
+    market = market_from_detail(detail, wallet, token, outcome, allow_no).book_market()
+    until = min(expiration, observed[1] + TTL_MS)
+    return (market, until) if until > source.observe()[1] else None
+
+
+def offer(queue, hint):
+    try:
+        queue.put_nowait(hint)
+    except Full:
+        try:
+            queue.get_nowait()
+        except Empty:
+            pass
+        queue.put_nowait(hint)
+
+
+def watch(wallet, stop, deadline, hints, report, *, allow_no):
+    filters = {'address': sorted(source.FEE_MODULES),
+               'topics': [source.MATCH, None, source.address_topic(wallet)]}
+    request = {'jsonrpc': '2.0', 'id': 1, 'method': 'eth_subscribe', 'params': ['logs', filters]}
+    seen = OrderedDict()
+    while not stop.is_set() and time.monotonic() < deadline:
+        try:
+            with socket.create_connection((HOST, 443), timeout=3) as raw:
+                with ssl.create_default_context().wrap_socket(raw, server_hostname=HOST) as conn:
+                    with conn.makefile('rb', buffering=0) as stream:
+                        source.upgrade(conn, stream, HOST, '/')
+                        source.send_frame(conn, json.dumps(request).encode())
+                        reply = json.loads(source.read_frame(conn, stream))
+                        subscription = reply.get('result')
+                        if reply.get('id') != 1 or not isinstance(subscription, str) or not subscription:
+                            raise ValueError('Base did not accept the log subscription')
+                        report({'stage': 'limitless-tip', 'status': 'subscribed'})
+                        while not stop.is_set() and time.monotonic() < deadline:
+                            if not conn.pending() and not select.select([conn], [], [], .25)[0]:
+                                continue
+                            frame = source.read_frame(conn, stream)
+                            if frame is None:
+                                continue
+                            notice = json.loads(frame)
+                            params = notice.get('params') or {}
+                            if notice.get('method') != 'eth_subscription' or params.get('subscription') != subscription:
+                                continue
+                            log = params['result']
+                            key = log['blockHash'], log['transactionHash'], log['logIndex']
+                            if key in seen:
+                                continue
+                            seen[key] = None
+                            if len(seen) > 256:
+                                seen.popitem(last=False)
+                            try:
+                                hint = hint_for(log, wallet, source.observe(), allow_no)
+                            except (OSError, KeyError, ValueError, TypeError, AttributeError, GateSkip):
+                                continue
+                            if hint:
+                                offer(hints, hint)
+                                report({'stage': 'limitless-tip', 'status': 'book_hint'})
+        except (OSError, EOFError, KeyError, TypeError, ValueError, AttributeError):
+            report({'stage': 'limitless-tip', 'status': 'retry'})
+            stop.wait(min(5, max(0, deadline - time.monotonic())))
