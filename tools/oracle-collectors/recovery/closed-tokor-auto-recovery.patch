+class ClosedWriteGuard:
+    """A durable marker survives a process crash until the operation is known."""
+
+    def __init__(self, directory, session_id):
+        self.path = directory / (session_id + '.unresolved-write')
+
+    def require_clear(self):
+        try:
+            self.path.lstat()
+        except FileNotFoundError:
+            return
+        # Even a partially written marker blocks all subsequent writers.
+        raise UnresolvedResult(self.path.name, 'recovery')
+
+    def sync_directory(self):
+        fd = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+
+    @contextmanager
+    def track(self, kind, identity):
+        self.require_clear()
+        fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        with os.fdopen(fd, 'w') as file:
+            json.dump({'kind': kind, 'identity': identity}, file)
+            file.flush()
+            os.fsync(file.fileno())
+        self.sync_directory()
+        try:
+            yield
+        except (Skip, IdleIngestCanceled):
+            # These are the existing, explicitly non-committed refusal paths.
+            self.clear()
+            raise
+        else:
+            self.clear()
+
+    def clear(self):
+        self.path.unlink()
+        self.sync_directory()
+
