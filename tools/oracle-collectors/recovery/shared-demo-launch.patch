new file mode 100644
--- /dev/null
+++ b/src/PublicDemoLaunch.tsx
@@ -0,0 +1,14 @@
+import {Link} from 'react-router-dom';
+import type {Locale,VenueCode} from './api';
+import {isPaperLaunchTarget,normalizeTraderAddress,realTraderPaperPath} from './paperTraderRoute';
+
+export function PublicDemoLaunch({locale,venue,address,profileAddress,className}:{
+  locale:Locale;venue:VenueCode;address:string;profileAddress?:string;className?:string;
+}) {
+  const canonical=normalizeTraderAddress(address);
+  if(!canonical||!isPaperLaunchTarget(venue,canonical))return null;
+  return <Link className={`ui-btn ui-btn-primary${className?' '+className:''}`}
+    to={realTraderPaperPath(venue,canonical,true,profileAddress)}>
+    {locale==='ru'?'Попробовать в демо':'Try in demo'}
+  </Link>;
+}
