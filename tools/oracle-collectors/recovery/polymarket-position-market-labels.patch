+function attachPositionLabels(positions:CoreState['positions'], labels:unknown) {
+  if(labels===undefined)return positions;
+  if(!Array.isArray(labels)||labels.length>positions.length)bad();
+  const key=(position:{conditionId:string;tokenId:string})=>JSON.stringify([position.conditionId,position.tokenId]);
+  const positionKeys=new Set(positions.map(key));
+  const matched=new Map<string,{marketTitle:string;outcome:string}>();
+  for(const raw of labels as unknown[]){
+    const label=exactObject(raw,['conditionId','tokenId','marketTitle','outcome']);
+    if(typeof label.conditionId!=='string'||typeof label.tokenId!=='string'||
+      typeof label.marketTitle!=='string'||!label.marketTitle.trim()||label.marketTitle.length>2048||/\p{Cc}/u.test(label.marketTitle)||
+      typeof label.outcome!=='string'||!label.outcome.trim()||label.outcome.length>256||/\p{Cc}/u.test(label.outcome))bad();
+    const id=key({conditionId:label.conditionId as string,tokenId:label.tokenId as string});
+    if(!positionKeys.has(id)||matched.has(id))bad();
+    matched.set(id,{marketTitle:label.marketTitle as string,outcome:label.outcome as string});
+  }
+  return positions.map(position=>{
+    const label=matched.get(key(position));
+    return label?{...position,...label}:position;
+  });
+}
