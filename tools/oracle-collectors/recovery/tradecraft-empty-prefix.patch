+def trim_verified_empty_prefix(prepared, current):
+    """Reuse the original quote after the cursor passes only verified empty blocks."""
+    if prepared.cursor == current:
+        return prepared.envelope
+
+    mutable = {'checkpoint', 'lastOperationId', 'lastObservedAt'}
+    old_identity = {key: value for key, value in prepared.cursor.items() if key not in mutable}
+    current_identity = {key: value for key, value in current.items() if key not in mutable}
+    if current_identity != old_identity:
+        raise Skip('PERSONAL_CURSOR_ADVANCED')
+
+    request = prepared.envelope['request']
+    batch = request['ingest']
+    checkpoint = current['checkpoint']
+    block = int(checkpoint['number'])
+    prefix = next((index for index, header in enumerate(batch['headers'])
+                   if header['number'] == checkpoint['number'] and header['hash'] == checkpoint['hash']), None)
+    if (prefix is None or block >= int(batch['finalized']['number'])
+            or any(int(log['blockNumber']) <= block for log in batch['logs'])):
+        raise Skip('PERSONAL_CURSOR_ADVANCED')
@@ -83,0 +106,4 @@
+    trimmed = dict(batch, previous=checkpoint, headers=batch['headers'][prefix+1:])
+    del trimmed['evidenceSha256']
+    trimmed['evidenceSha256'] = sha(trimmed)
+    return dict(prepared.envelope, request=dict(request, ingest=trimmed))
