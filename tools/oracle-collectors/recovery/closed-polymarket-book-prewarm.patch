+def discover_book_target(wallet):
+    """Use recent buys only to choose a WebSocket subscription."""
+    raw, _, _ = fetch_page(wallet, int(time.time()) - 86400, None)
+    rows, _ = document_rows(raw)
+    used = set()
+    for row, _ in rows:
+        if str(row.get('proxy_wallet', '')).lower() != wallet or row.get('side') != 'BUY':
+            continue
+        slug = row.get('slug')
+        if not isinstance(slug, str) or not poly.SLUG.fullmatch(slug) or slug in used:
+            continue
+        try:
+            market = source.Market('polymarket', row['condition_id'], row['token_id'], wallet, slug)
+        except (KeyError, TypeError, ValueError, AttributeError):
+            continue
+        used.add(slug)
+        details = source.json_read(f'{source.POLY_MARKETS}/markets?' + urlencode({'slug': slug}))
+        for detail in details:
+            if (detail.get('slug') == slug and detail.get('conditionId') == market.market
+                    and detail.get('acceptingOrders') is True and detail.get('active') is True
+                    and detail.get('closed') is False and market.token in json.loads(detail['clobTokenIds'])):
+                return market
+        if len(used) == 4:
+            break
+    return None
+
+
+def warm_book_targets(wallet, halt, deadline, targets):
+    while not halt.is_set() and time.monotonic() < deadline:
+        try:
+            market = discover_book_target(wallet)
+            if market is not None:
+                targets.put_nowait(market)
+        except (KeyError, ValueError, TypeError, OSError, Full):
+            pass
+        halt.wait(min(90, max(0, deadline - time.monotonic())))
+
+
