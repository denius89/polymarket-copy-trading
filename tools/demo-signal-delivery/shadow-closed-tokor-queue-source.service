[Unit]
Description=Closed Tokor Polygon queue source
After=network-online.target docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/lib/shadow-closed-tokor/runtime
Environment=PYTHONPATH=/var/lib/shadow-closed-tokor/driver
Environment=PGSERVICEFILE=/var/lib/shadow-closed-tokor/runtime/pg_service.conf
EnvironmentFile=/var/lib/shadow-closed-tokor/runtime/queue-source.env
ExecStart=/usr/bin/python3 -B /var/lib/shadow-closed-tokor/runtime/closed_polygon_source.py /var/lib/shadow-closed-tokor/runtime/config.json --until ${QUEUE_UNTIL}
Restart=on-abnormal
NoNewPrivileges=true
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
