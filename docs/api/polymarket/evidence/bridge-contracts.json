            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/withdraw": {
      "post": {
        "tags": [
          "Bridge"
        ],
        "parameters": [
