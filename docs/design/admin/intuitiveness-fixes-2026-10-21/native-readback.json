        },
        {
          "id": "I3182:78759;2211:743",
          "text": "Мой аккаунт и доступ"
        },
        {
          "id": "I3182:78759;2211:744",
          "text": "/"
        },
        {
          "id": "I3182:78759;2211:745",
          "text": "Личный профиль"
        },
        {
          "id": "3182:78761",
          "text": "Личный профиль"
        },
        {
          "id": "3182:78762",
          "text": "Учебный прототип · Paper Alpha: комиссия Shadow 0%"
        },
        {
          "id": "I3185:81662;1981:8",
          "text": "Контекст и ограничения"
        },
        {
          "id": "I3185:81662;1981:9",
          "text": "Личная учётная запись текущего сотрудника. Профиль не выдаёт дополнительные права. Все данные учебные."
        },
        {
          "id": "I3684:146418;1981:8",
          "text": "Мои права · только просмотр"
        },
        {
          "id": "I3684:146418;1981:9",
          "text": "Учебные задачи: инциденты, сверка, поддержка и диагностика.\nПоддержка: ответ, внутренняя заметка, назначение и статус. Статус не отправляет сообщение.\nНет управления деньгами сервиса и выдачей прав.\nСреда: Paper Alpha. Площадки: Polymarket и Limitless.\nСрок назначения: нет подтверждённых данных. Реальные права проверяются при каждом действии."
        },
        {
          "id": "I3185:81666;2202:635",
          "text": "Параметр"
        },
        {
          "id": "I3185:81666;2202:636",
          "text": "Значение / состояние"
        },
        {
          "id": "I3185:81666;2202:637",
          "text": "Область и ограничение"
        },
        {
          "id": "I3185:81670;2137:26728",
          "text": "Сотрудник"
        },
        {
          "id": "I3185:81670;2137:26729",
          "text": "Олег Смирнов"
        },
        {
          "id": "I3185:81670;2137:26730",
          "text": "STAFF-206"
        },
        {
          "id": "I3185:81674;2137:26728",
          "text": "Права"
        },
        {
          "id": "I3185:81674;2137:26729",
          "text": "Операционная работа и поддержка"
        },
        {
          "id": "I3185:81674;2137:26730",
          "text": "Просмотр своих полномочий, без изменения назначения"
        },
        {
          "id": "I3185:81682;2137:26728",
          "text": "Защита аккаунта"
        },
        {
          "id": "I3185:81682;2137:26729",
          "text": "Защищённый способ по текущим полномочиям"
        },
        {
          "id": "I3185:81682;2137:26730",
          "text": "Секреты не показываются; восстановление не возвращает старые сеансы"
        },
        {
          "id": "I3623:146236;2254:1061;2081:182",
          "text": "Язык интерфейса"
        },
        {
          "id": "I3623:146236;2254:1061;2081:184",
          "text": "Русский · RU"
        },
        {
          "id": "I3623:146236;2254:1061;2081:185",
          "text": "Выбор сохраняется автоматически"
        },
        {
          "id": "3623:146245",
          "text": "Откройте профиль из рабочего раздела, чтобы вернуться к своей работе."
        },
        {
          "id": "I3185:81687;113:210",
          "text": "Назад к рабочему экрану"
        },
        {
          "id": "I3185:81692;113:210",
          "text": "Выйти на этом устройстве"
        },
        {
          "id": "3185:81697",
          "text": "Макет для вычитки · данные вымышлены · реальные операции выключены"
        }
      ],
