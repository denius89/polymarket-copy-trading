        {
          "id": "2008:967",
          "text": "Form layout · fields are not editable in this prototype"
        },
        {
          "id": "2560:42542",
          "text": "This is a future-form layout: these fields are not editable in Figma. To review P-14, choose the worked payout example. Owners set real values in the product; a different Owner activates rule changes."
        },
        {
          "id": "I2008:968;1981:8",
          "text": "Context"
        },
        {
          "id": "I2008:968;1981:9",
          "text": "Single payout, daily total, partner, source and new address are separate checks. Window and fee inclusion belong to the rule version. An empty template cannot be activated."
        },
        {
          "id": "I2010:2426;2019:6",
          "text": "Single payout, USD"
        },
        {
          "id": "I2010:2426;2019:8",
          "text": "Enter a value"
        },
        {
          "id": "I2010:2426;2019:9",
          "text": "A higher full payout requires another owner. The debt is never split."
        },
        {
          "id": "I2010:2431;2019:6",
          "text": "Daily total, USD"
        },
        {
          "id": "I2010:2431;2019:8",
          "text": "Enter a value"
        },
        {
          "id": "I2010:2431;2019:9",
          "text": "Sum of operations for the configured day and time zone."
        },
        {
          "id": "I2010:2436;2019:6",
          "text": "Partner total, USD"
        },
        {
          "id": "I2010:2436;2019:8",
          "text": "Enter a value"
        },
        {
          "id": "I2010:2436;2019:9",
          "text": "Aggregation for one partner; the rule defines the comparison base."
        },
        {
          "id": "I2010:2442;2019:6",
          "text": "Source total, USD"
        },
        {
          "id": "I2010:2442;2019:8",
          "text": "Enter a value"
        },
        {
          "id": "I2010:2442;2019:9",
          "text": "Aggregation for one registered payout source."
        },
        {
          "id": "I2010:2447;2019:6",
          "text": "New recipient, USD"
        },
        {
          "id": "I2010:2447;2019:8",
          "text": "Enter a value"
        },
        {
          "id": "I2010:2447;2019:9",
          "text": "New recipient controls preserve two approvals and the 24-hour delay."
        },
        {
          "id": "I2010:2452;2019:6",
          "text": "Aggregation period"
        },
        {
          "id": "I2010:2452;2019:8",
          "text": "Enter a value"
        },
        {
          "id": "I2010:2452;2019:9",
          "text": "Time window used to aggregate operations for this rule."
        },
        {
          "id": "I3686:146391;2019:6",
          "text": "Time zone"
        },
        {
          "id": "I3686:146391;2019:8",
          "text": "Enter an IANA time zone"
        },
        {
          "id": "I3686:146391;2019:9",
          "text": "Format examples: UTC, Africa/Cairo. Example only, not an active setting."
        },
        {
          "id": "I2010:2458;2019:11",
          "text": "Include transfer fee"
        },
        {
          "id": "I2010:2458;2019:13",
          "text": "Choose an option"
        },
        {
          "id": "I2010:2458;2019:15",
          "text": "Whether the transfer fee enters the comparison base. The payer is separate."
        },
        {
          "id": "I2010:2462;2019:6",
          "text": "Accounting unit"
        },
        {
          "id": "I2010:2462;2019:8",
          "text": "USD · 1 USDT = $1"
        },
        {
          "id": "I2010:2462;2019:9",
          "text": "Fixed internal accounting rule: 1 USDT = $1."
        },
        {
          "id": "I2010:2467;2019:6",
          "text": "Reason"
        },
        {
          "id": "I2010:2467;2019:8",
          "text": "Enter a value"
        },
        {
          "id": "I2010:2467;2019:9",
          "text": "Owner configures manually"
        },
        {
          "id": "I2008:974;113:208",
          "text": "Open the worked example"
        },
