        },
        {
          "id": "3182:78757",
          "text": "Олег Смирнов · STAFF-206 · операционный руководитель"
        },
        {
          "id": "I3182:78759;2211:741",
          "text": "Рабочая область"
        },
        {
          "id": "I3182:78759;2211:742",
