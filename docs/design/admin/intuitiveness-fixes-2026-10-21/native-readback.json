        {
          "id": "I2217:100338;2211:742",
          "text": "/"
        },
        {
          "id": "I2217:100338;2211:743",
          "text": "Аварийное управление"
        },
        {
          "id": "I2217:100338;2211:744",
          "text": "/"
        },
        {
          "id": "I2217:100338;2211:745",
          "text": "Закрыть пользовательский сервис?"
        },
        {
          "id": "2138:60274",
          "text": "Закрыть пользовательский сервис?"
        },
        {
          "id": "I2454:45306;2451:1527",
          "text": "Технический режим"
        },
        {
          "id": "I2454:45306;2451:1532",
          "text": "Пользователь видит «Сервис временно недоступен». Новые торговые и денежные действия через Shadow запрещены также на сервере. Работают только аварийная админка, мониторинг, журнал аудита, инциденты, безопасная сверка и восстановление."
        },
        {
          "id": "I2454:45306;2451:1533",
          "text": "Подробнее"
        },
        {
          "id": "2138:60275",
          "text": "Полное отключение · Учебная среда / весь Shadow"
        },
        {
          "id": "2454:45319",
          "text": "Полностью закрывает приложение и публичный API; останавливает все продуктовые фоновые задачи."
        },
        {
          "id": "I2138:60276;2081:589",
          "text": "Важно"
        },
        {
          "id": "I2138:60276;2081:590",
          "text": "Остановятся: приложение, публичный API, новые торговые и денежные действия, продуктовые задания.\nПродолжат работать: аварийная админка, наблюдение, журнал, инциденты, безопасная сверка и восстановление.\nУже отправленные операции могут завершиться. Сверка ничего не отправляет."
        },
        {
          "id": "2470:121168",
          "text": "Пользователь видит «Сервис временно недоступен». Запрет действует также на сервере. Сверка только проверяет результаты и ничего не отправляет. Уже отправленные операции могут завершиться; прямые действия вне Shadow не блокируются."
        },
        {
          "id": "I2203:25492;2202:635",
          "text": "Параметр"
        },
        {
          "id": "I2203:25492;2202:636",
          "text": "Значение / состояние"
        },
        {
          "id": "I2203:25492;2202:637",
          "text": "Примечание / контекст"
        },
        {
          "id": "I2138:60280;2137:26728",
          "text": "Весь Shadow"
        },
        {
          "id": "I2138:60280;2137:26729",
          "text": "Весь Shadow в учебной среде"
        },
        {
          "id": "I2138:60280;2137:26730",
          "text": "TECH_MODE"
        },
        {
          "id": "I2138:60284;2137:26728",
          "text": "Версия"
        },
        {
          "id": "I2138:60284;2137:26729",
          "text": "CTRL-TECH_MODE v2"
        },
        {
          "id": "I2138:60284;2137:26730",
          "text": "Demo"
        },
        {
          "id": "I2138:60288;2137:26728",
          "text": "Включает"
        },
        {
          "id": "I2138:60288;2137:26729",
          "text": "Нора Азиз · STAFF-203"
        },
        {
          "id": "I2138:60288;2137:26730",
          "text": "Один уполномоченный сотрудник"
        },
        {
          "id": "I2138:60292;2137:26728",
          "text": "Отправленные операции"
        },
        {
          "id": "I2138:60292;2137:26729",
          "text": "Сверка продолжается"
        },
        {
          "id": "I2138:60292;2137:26730",
          "text": "Нет фиктивной отмены"
        },
        {
          "id": "I2138:60297;2081:128",
          "text": "Закрыть сервис для пользователей · демо"
        },
        {
          "id": "I2138:60302;2081:74",
          "text": "К параметрам режима"
        },
        {
          "id": "2138:60307",
          "text": "Демонстрационный прототип: поля и результаты статические. Кнопки ведут между макетами и не выполняют реальных операций."
        }
