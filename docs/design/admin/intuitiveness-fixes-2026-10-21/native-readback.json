        {
          "id": "I1986:39233;2019:6",
          "text": "Причина · обязательное поле"
        },
        {
          "id": "I1986:39233;2019:8",
          "text": "Тест согласованного VIP-сценария"
        },
        {
          "id": "I1986:39233;2019:9",
          "text": "Записывается в аудит вместе с автором и версией"
        },
        {
          "id": "I1982:37935;1981:8",
          "text": "Форма прототипа"
        },
        {
          "id": "I1982:37935;1981:9",
          "text": "Поля представлены заполненным примером. Свободный ввод и выбор профилей будут в реализации."
