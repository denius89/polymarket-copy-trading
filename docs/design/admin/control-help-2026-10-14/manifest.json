{
  "config": [
    {
      "key": "global",
      "code": "GLOBAL_STOP",
      "ru": {
        "title": "Глобальная остановка",
        "summary": "Запрещает новые торговые и денежные действия через Shadow.",
        "body": "Действует в выбранной среде и на выбранных площадках. Не отменяет уже отправленные операции или прямые действия вне сервиса. Диагностика и сверка продолжаются.",
        "off": "Новые торговые и денежные действия через Shadow в указанной области.",
        "on": "Мониторинг, аудит, инциденты и безопасная сверка.",
        "started": "Отправленные заявки и переводы могут завершиться. Неизвестный результат проверяется без повторной отправки.",
        "restore": "После устранения причины: проверка, Owner и независимый подтверждающий. Другие ограничения продолжают действовать."
      },
      "en": {
        "title": "Global stop",
        "summary": "Blocks new trading and money actions through Shadow.",
        "body": "Applies to the selected environment and venues. Does not cancel operations already sent or direct activity outside the service. Monitoring and reconciliation continue.",
        "off": "New trading and money actions through Shadow in the selected scope.",
        "on": "Monitoring, audit, incidents and safe reconciliation.",
        "started": "Submitted orders and transfers may complete. Unknown outcomes are verified without resubmission.",
        "restore": "After the cause is resolved: checks, an Owner and independent confirmation. Other restrictions remain active."
      }
    },
    null,
    {
      "key": "deposits",
      "code": "DEPOSITS_OFF",
      "ru": {
        "title": "Отключение пополнений",
        "summary": "Блокирует пополнение через Shadow.",
        "body": "Отключает функции и новые инструкции пополнения через Shadow в выбранной области. Прямые переводы вне сервиса могут поступать. Уже поступившие средства не отменяются."
      },
      "en": {
        "title": "Disable deposits",
        "summary": "Blocks deposits through Shadow.",
        "body": "Disables deposit functions and new deposit instructions through Shadow in the selected scope. Direct transfers outside the service may arrive. Funds already received are not reversed."
      }
    },
    {
      "key": "withdrawals",
      "code": "WITHDRAWALS_OFF",
      "ru": {
        "title": "Отключение выводов",
        "summary": "Блокирует новые пользовательские выводы через Shadow.",
        "body": "Действует на выбранной площадке и в выбранной области. Не блокирует прямые действия пользователя вне Shadow. Уже отправленный вывод не отменяется этим ограничением."
      },
      "en": {
        "title": "Disable withdrawals",
        "summary": "Blocks new user withdrawals through Shadow.",
        "body": "Applies to the selected venue and scope. Does not block direct user activity outside Shadow. A withdrawal already submitted is not cancelled by this restriction."
      }
    },
    {
      "key": "partner",
      "code": "PARTNER_PAYOUTS_OFF",
      "ru": {
        "title": "Отключение выплат партнёрам",
        "summary": "Запрещает отправку новых выплат партнёрам.",
        "body": "Останавливает новые отправки в выбранной области. Начисленные обязательства сохраняются; уже отправленные выплаты проверяются. Неизвестный результат не разрешает повторную отправку."
      },
      "en": {
        "title": "Disable partner payouts",
        "summary": "Blocks submission of new partner payouts.",
        "body": "Stops new submissions in the selected scope. Accrued liabilities remain; submitted payouts are reconciled. An unknown outcome does not permit resubmission."
      }
    }
  ],
